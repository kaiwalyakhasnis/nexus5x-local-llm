# Audio layer, merged after local-llm.config (FRAG="config/local-llm.config config/audio.config").
# Puts back what the trim removed for the microphone and speaker:
#   - the ADSP (Qualcomm audio DSP): PIL loader, subsystem monitor, APR messaging
#   - ALSA + ASoC with the msm8994 machine driver, SLIMbus and the WCD9330 codec
#     (the mic is a digital mic on the codec, the speaker is driven by the codec)
#   - eMMC + ext4, to read the ADSP firmware from the phone's own `vendor`
#     partition (/vendor/firmware/adsp.*), mounted read-only with noload
# Options the defconfig sets under these menus come back with them.

# --- ADSP
CONFIG_MSM_PIL=y
CONFIG_MSM_PIL_SSR_GENERIC=y
CONFIG_MSM_SYSMON_COMM=y
CONFIG_MSM_ADSP_LOADER=y
CONFIG_MSM_QDSP6_APRV2=y
CONFIG_MSM_QDSP6V2_CODECS=y
CONFIG_IPC_ROUTER=y
CONFIG_MSM_IPC_ROUTER_SMD_XPRT=y
CONFIG_MSM_QMI_INTERFACE=y
CONFIG_QMI_ENCDEC=y

# --- sound
CONFIG_SOUND=y
CONFIG_SLIMBUS_MSM_NGD=y
CONFIG_WCD9330_CODEC=y
CONFIG_MSM_AVTIMER=y

# --- read-only access to the firmware partition
CONFIG_MMC=y
CONFIG_EXT4_FS=y
