# nexus5x-local-llm: merged onto lineageos_bullhead_defconfig.
# Goal: the smallest kernel that boots the phone, keeps it safe (power, thermal,
# charging) and runs a CPU-only LLM from RAM, driven over a USB network link.
# Kept on purpose (not listed): SoC core (SMD, SMEM, RPM, SPM, SCM, clocks, bus
# scaling, IOMMU + ION, which its headers need), regulators incl. CPR, CPU idle/freq, SCHED_HMP, thermal
# (TSENS, msm_thermal, BCL, ADC_TM), charger + fuel gauge, USB DWC3 gadget,
# I2C (Type-C CC chip, parallel charger), keys, RTC, watchdog, pstore, and the
# subsystem-restart framework (LGE_HANDLE_PANIC uses it; nothing registers with
# it once PIL is gone).

# --- added: devtmpfs so /dev is populated without ueventd/mdev
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- Android userspace support
# CONFIG_ANDROID_BINDER_IPC is not set
# CONFIG_ASHMEM is not set
# CONFIG_ANDROID_LOW_MEMORY_KILLER is not set
# CONFIG_ANDROID_INTF_ALARM_DEV is not set
# CONFIG_ONESHOT_SYNC is not set
# CONFIG_UID_STAT is not set
# CONFIG_UID_CPUTIME is not set
# CONFIG_SDCARD_FS is not set
# CONFIG_PM_AUTOSLEEP is not set
# CONFIG_PM_WAKELOCKS is not set
# CONFIG_INPUT_KEYCHORD is not set

# --- security / accounting
# CONFIG_AUDIT is not set
# CONFIG_SECURITY is not set
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_NAMESPACES is not set
# SCHED_HMP (big.LITTLE task placement) needs CGROUP_SCHED -> FAIR_GROUP_SCHED; keep only that
# CONFIG_CGROUP_DEBUG is not set
# CONFIG_CGROUP_FREEZER is not set
# CONFIG_CPUSETS is not set
# CONFIG_CGROUP_CPUACCT is not set
# CONFIG_RESOURCE_COUNTERS is not set
# CONFIG_CFS_BANDWIDTH is not set
# CONFIG_RT_GROUP_SCHED is not set

