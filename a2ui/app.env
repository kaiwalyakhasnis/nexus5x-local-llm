# Sourced by embedded-compose's ./ec when it builds this app (APP_DIR=a2ui).
# The A2UI renderer, a repo of its own (path relative to this directory;
# scripts/build-a2ui.sh passes EC_A2UI from local.env if set).
APP_LIBS="a2ui=${EC_A2UI:-../../embedded-compose-a2ui}"
# Runtime files (paths relative to the embedded-compose checkout): Roboto for
# its ui.material, in /res/fonts. Everything else is drawn.
APP_IMAGES=
APP_FONTS="third_party/aosp/external/roboto-fonts/Roboto-Regular.ttf third_party/aosp/external/roboto-fonts/Roboto-Medium.ttf"
